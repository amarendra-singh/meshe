<section class="mesh-story">
  <div class="mesh-story__visual">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1800', sizes: '(min-width: 990px) 55vw, 100vw', alt: section.settings.image_alt }}{% endif %}</div>
  <div class="mesh-story__copy"><p class="mesh-story__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="mesh-story__intro">{{ section.settings.body }}</div>
    <ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span aria-hidden="true">0{{ forloop.index }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></li>{% endfor %}</ol>
    <a href="{{ section.settings.url | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
  </div>
</section>
{% stylesheet %}
.mesh-story{display:grid;grid-template-columns:1.05fr 1fr;background:#071d49;color:#fff;font-family:Arial,sans-serif}
.mesh-story__visual{min-height:620px;background:#eee3d2}.mesh-story__visual img{display:block;width:100%;height:100%;object-fit:cover;object-position:65% center}
.mesh-story__copy{padding:clamp(32px,5vw,78px);align-self:center}.mesh-story__eyebrow{font-size:13px;font-weight:700;letter-spacing:.13em;color:#ffd16c;margin:0 0 18px}
.mesh-story h2{font:700 clamp(34px,3.8vw,56px)/1.05 Arial,sans-serif;color:white;letter-spacing:-.04em;margin:0 0 22px}.mesh-story__intro{font-size:18px;line-height:1.6;color:#dae5fa}
.mesh-story ol{list-style:none;padding:0;margin:28px 0}.mesh-story li{display:flex;gap:18px;margin:20px 0}.mesh-story li>span{font-size:14px;color:#ffd16c;padding-top:3px}.mesh-story h3{font:700 19px/1.3 Arial,sans-serif;color:#fff;margin:0 0 6px}.mesh-story li p{font-size:16px;line-height:1.5;margin:0;color:#dae5fa}
.mesh-story__copy>a{display:inline-flex;align-items:center;gap:30px;background:#ffd16c;color:#071d49;padding:18px 26px;border-radius:14px;text-decoration:none;font-size:18px;font-weight:700}
@media(max-width:989px){.mesh-story{grid-template-columns:1fr}.mesh-story__visual{min-height:0;aspect-ratio:4/5}.mesh-story__copy{padding:38px 6%}}
{% endstylesheet %}
{% schema %}
{
  "name": "Mesh screen-free story",
  "settings": [
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "A family building a colourful wooden-block town together"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LESS SCROLLING. MORE SHARED MOMENTS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make room for one more “look what I made”."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Introduction",
      "default": "<p>Tonight can be a small adventure. Put a toy on the table, make a little space, and see where their curiosity takes you.</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Find your next play moment"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "idea",
      "name": "Play idea",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Make something together"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mesh screen-free story",
      "blocks": [
        {
          "type": "idea",
          "settings": {
            "title": "A little challenge",
            "text": "Let them try, change the plan and try again."
          }
        },
        {
          "type": "idea",
          "settings": {
            "title": "A little conversation",
            "text": "Take turns, share ideas and celebrate the small discoveries."
          }
        },
        {
          "type": "idea",
          "settings": {
            "title": "A little time together",
            "text": "Start with one screen-free play break that fits your family."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}
