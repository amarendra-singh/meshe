<div class="mesh-home">
  <section class="mesh-hero">
    {% assign hero = section.settings.hero %}
    {% if hero != blank %}
      {{ hero | image_url: width: 2400 | image_tag: class: 'mesh-hero__image', widths: '600, 900, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {% endif %}
    <div class="mesh-hero__copy">
      <p class="mesh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="mesh-hero__description">{{ section.settings.description | escape }}</p>
      <a class="mesh-button" href="{{ routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="mesh-content">
    <h2>{{ section.settings.categories_heading | escape }}</h2>
    <div class="mesh-categories">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a class="mesh-category" href="{{ block.settings.url }}" style="--tile: {{ block.settings.color }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.title | escape }} <span aria-hidden="true">›</span></span>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 400, 600', sizes: '(min-width: 750px) 25vw, 30vw' }}
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
    <h2 class="mesh-products-heading">{{ section.settings.products_heading | escape }}</h2>
    <div class="mesh-products">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
          {% assign item = block.settings.product %}
          {% if item != blank %}
            <a class="mesh-product" href="{{ item.url }}" {{ block.shopify_attributes }}>
              {{ item.featured_image | image_url: width: 1000 | image_tag: class: 'mesh-product__image', loading: 'lazy', widths: '300, 500, 750, 1000', sizes: '(min-width: 1200px) 560px, 46vw' }}
              <div class="mesh-product__copy"><h3>{{ item.title | escape }}</h3><p>{{ item.price | money }}</p></div>
            </a>
          {% elsif request.design_mode %}
            <div class="mesh-product" {{ block.shopify_attributes }}>
              {% if block.settings.preview_image != blank %}
                {{ block.settings.preview_image | image_url: width: 1000 | image_tag: class: 'mesh-product__image', loading: 'lazy' }}
              {% endif %}
              <div class="mesh-product__copy"><h3>{{ block.settings.preview_title | escape }}</h3><p>{{ block.settings.preview_price | escape }}</p></div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>
{% stylesheet %}
.mesh-home{--mesh-ink:#071d49;--mesh-blue:#0754ef;background:#fffcf5;color:var(--mesh-ink);font-family:Arial,sans-serif;letter-spacing:-.025em}
.mesh-home *{box-sizing:border-box}
.mesh-hero{position:relative;min-height:min(70vw,820px);background:#fbf6ed;overflow:hidden}
.mesh-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center bottom}
.mesh-hero__copy{position:relative;z-index:1;padding:3.7% 5.5%;max-width:780px}
.mesh-eyebrow{margin:0 0 14px;color:var(--mesh-blue);font-size:clamp(14px,2.1vw,20px);font-weight:700;letter-spacing:.055em}
.mesh-home h1{font:800 clamp(38px,7.1vw,76px)/1.02 Arial,sans-serif;letter-spacing:-.045em;color:var(--mesh-ink);margin:0 0 20px;max-width:670px}
.mesh-hero__description{font-size:clamp(18px,3.3vw,32px);line-height:1.15;color:#405271;max-width:640px;margin:0 0 24px}
.mesh-button{display:inline-flex;align-items:center;gap:26px;background:var(--mesh-blue);color:white;text-decoration:none;font-size:clamp(18px,2.8vw,28px);font-weight:600;padding:19px 36px;border-radius:22px;line-height:1.2;min-height:54px}
.mesh-button span{font-size:1.5em;line-height:1}
.mesh-content{max-width:1280px;margin:auto;padding:30px 3.8% 28px}
.mesh-home h2{font:700 clamp(28px,4.7vw,48px)/1.1 Arial,sans-serif;letter-spacing:-.035em;color:var(--mesh-ink);margin:0 0 24px}
.mesh-categories,.mesh-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.mesh-category{display:flex;align-items:center;justify-content:space-between;min-height:170px;padding:20px 7%;border-radius:18px;background:var(--tile);color:var(--mesh-ink);text-decoration:none;overflow:hidden}
.mesh-category>span{font-size:clamp(20px,3.2vw,30px);line-height:1.15;font-weight:700;max-width:48%}
.mesh-category>span>span{padding-left:8px}
.mesh-category img{width:48%;height:140px;object-fit:contain;mix-blend-mode:multiply}
.mesh-home .mesh-products-heading{margin-top:44px}
.mesh-product{display:block;overflow:hidden;border:1px solid #ece9e5;border-radius:16px;text-decoration:none;background:#fff;color:var(--mesh-ink)}
.mesh-product__image{display:block;width:100%;height:auto;aspect-ratio:1.76;object-fit:contain;background:#f6f3ef;border-radius:16px}
.mesh-product__copy{padding:12px 16px 15px}
.mesh-product h3{margin:0;color:var(--mesh-ink);font:600 clamp(16px,2.4vw,25px)/1.2 Arial,sans-serif;letter-spacing:-.025em}
.mesh-product p{font-size:clamp(18px,2.6vw,28px);line-height:1.2;font-weight:700;margin:7px 0 0}
.mesh-home a:focus-visible{outline:3px solid #ff8547;outline-offset:4px}
@media(max-width:749px){.mesh-hero{min-height:700px}.mesh-hero__image{object-position:63% bottom}.mesh-hero__copy{padding:30px 5.5%}.mesh-home h1{font-size:44px;max-width:440px}.mesh-hero__description{font-size:21px;max-width:360px}.mesh-eyebrow{font-size:13px}.mesh-button{padding:16px 24px;border-radius:16px;font-size:19px}.mesh-content{padding:28px 4%}.mesh-category{min-height:112px;padding:12px 8%}.mesh-category>span{font-size:17px}.mesh-category img{height:90px}.mesh-categories,.mesh-products{gap:12px}.mesh-home h2{font-size:29px}.mesh-product__copy{padding:10px}.mesh-product h3{font-size:15px}.mesh-product p{font-size:18px}.mesh-product__image{aspect-ratio:1.2}}
{% endstylesheet %}
