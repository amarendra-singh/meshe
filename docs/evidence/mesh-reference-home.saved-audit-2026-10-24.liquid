{% liquid
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign visible_products = 0
  for block in product_blocks
    if block.settings.product != blank or request.design_mode
      assign visible_products = visible_products | plus: 1
    endif
  endfor
%}
<div class="mesh-home" style="--mesh-ink: {{ section.settings.ink }}; --mesh-blue: {{ section.settings.accent }}; --mesh-paper: {{ section.settings.background }};">
  <section class="mesh-hero">
    {% assign hero = section.settings.hero %}
    {% if hero != blank %}
      {{ hero | image_url: width: 2400 | image_tag: class: 'mesh-hero__image', widths: '600, 900, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {% endif %}
    <div class="mesh-hero__copy">
      <p class="mesh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="mesh-hero__description">{{ section.settings.description | escape }}</p>
      {% if section.settings.button != blank %}
        <a class="mesh-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </section>
  <section class="mesh-content">
    {% if category_blocks.size > 0 %}
    <h2>{{ section.settings.categories_heading | escape }}</h2>
    <div class="mesh-categories">
      {% for block in category_blocks %}
          {% liquid
            assign category = block.settings.collection
            assign category_url = category.url | default: block.settings.url
            assign category_title = block.settings.title | default: category.title
            assign category_image = block.settings.image | default: category.featured_image
          %}
          <a class="mesh-category" {% if category_url != blank %}href="{{ category_url }}"{% else %}role="link" aria-disabled="true"{% endif %} style="--tile: {{ block.settings.color }}" {{ block.shopify_attributes }}>
            <span>{{ category_title | escape }} <span aria-hidden="true">›</span></span>
            {% if category_image != blank %}
              {{ category_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '160, 240, 400, 600', sizes: '(min-width: 1280px) 270px, 22vw', alt: '' }}
            {% endif %}
          </a>
      {% endfor %}
    </div>
    {% endif %}
    {% if visible_products > 0 %}
    <h2 class="mesh-products-heading">{{ section.settings.products_heading | escape }}</h2>
    <div class="mesh-products">
      {% for block in product_blocks %}
          {% assign item = block.settings.product %}
          {% if item != blank %}
            <a class="mesh-product" href="{{ item.url }}" {{ block.shopify_attributes }}>
              {% if item.featured_image != blank %}
                {{ item.featured_image | image_url: width: 1200 | image_tag: class: 'mesh-product__image', loading: 'lazy', widths: '300, 500, 750, 1000, 1200', sizes: '(min-width: 1280px) 584px, 46vw' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'mesh-product__image' }}
              {% endif %}
              <div class="mesh-product__copy">
                <h3>{{ item.title | escape }}</h3>
                <p>{{ item.price_min | money }}{% if item.price_varies %} – {{ item.price_max | money }}{% endif %}</p>
                {% unless item.available %}<span class="mesh-product__availability">{{ section.settings.sold_out_label | escape }}</span>{% endunless %}
              </div>
            </a>
          {% elsif request.design_mode %}
            <div class="mesh-product" {{ block.shopify_attributes }}>
              {% if block.settings.preview_image != blank %}
                {{ block.settings.preview_image | image_url: width: 1200 | image_tag: class: 'mesh-product__image', loading: 'lazy', widths: '300, 500, 750, 1000, 1200', sizes: '(min-width: 1280px) 584px, 46vw' }}
              {% endif %}
              <div class="mesh-product__copy"><h3>{{ block.settings.preview_title | escape }}</h3><p>{{ block.settings.preview_price | escape }}</p></div>
            </div>
          {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </section>
</div>
{% stylesheet %}
body:has(.mesh-home) .utility-bar{background:#1a5ce3;color:#fff;border:0}
body:has(.mesh-home) .announcement-bar__message{padding:14px 0;font:500 20px/23px Arial,sans-serif;letter-spacing:0;color:#fff}
body:has(.mesh-home) .announcement-bar__link{color:#fff}
body:has(.mesh-home) .header-wrapper{background:#fffcf5;border:0}
body:has(.mesh-home) .header{padding:4px 4.5%;min-height:97px;max-width:none;color:#071d49}
body:has(.mesh-home) .header__icon{color:#071d49}
body:has(.mesh-home) .header__icons{gap:24px}
body:has(.mesh-home) .header__icon--account{display:none}
body:has(.mesh-home) .header__icon--search .icon{width:32px;height:32px}
body:has(.mesh-home) .header__icon--cart .icon{width:54px;height:54px}
@media(min-width:750px){body:has(.mesh-home) .header{grid-template-areas:'heading icons';grid-template-columns:1fr auto}body:has(.mesh-home) .header__inline-menu,body:has(.mesh-home) header-drawer,body:has(.mesh-home) .header>.header__search{display:none}body:has(.mesh-home) .header__heading,body:has(.mesh-home) .header__heading-link{justify-self:start}}
@media(max-width:749px){body:has(.mesh-home) .header{min-height:80px}body:has(.mesh-home) .header__heading-logo{max-width:140px}body:has(.mesh-home) .header__icons{gap:4px}body:has(.mesh-home) .announcement-bar__message{font-size:14px;line-height:20px;padding:10px 0}body:has(.mesh-home) .header__icon--search .icon{width:24px;height:24px}}
.mesh-home{background:var(--mesh-paper,#fffcf5);color:var(--mesh-ink,#071d49);font-family:Arial,sans-serif;letter-spacing:-.025em;line-height:1.2}
.mesh-home *{box-sizing:border-box}
.mesh-hero{position:relative;min-height:min(69.6vw,820px);background:#fbf6ed;overflow:hidden}
.mesh-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center bottom}
.mesh-hero__copy{position:relative;z-index:1;padding:3.7% 5.5%;max-width:900px}
.mesh-eyebrow{margin:0 0 12px;color:var(--mesh-blue);font-size:clamp(14px,2.1vw,20px);line-height:1.2;font-weight:700;letter-spacing:.055em}
.mesh-home h1{font:800 clamp(38px,7.1vw,76px)/1.02 Arial,sans-serif;letter-spacing:-.045em;color:var(--mesh-ink);margin:0 0 20px;max-width:min(670px,65vw)}
.mesh-hero__description{font-size:clamp(18px,3.3vw,32px);line-height:1.15;color:#405271;max-width:min(640px,58vw);margin:0 0 24px}
.mesh-button{display:inline-flex;align-items:center;gap:26px;background:var(--mesh-blue);color:white;text-decoration:none;font-size:clamp(18px,2.8vw,28px);font-weight:600;padding:19px 36px;border-radius:22px;line-height:1.2;min-height:54px;max-width:100%}
.mesh-button span{font-size:1.5em;line-height:1}
.mesh-content{max-width:1280px;margin:auto;padding:30px 3.8% 28px}
.mesh-home h2{font:700 clamp(28px,4.95vw,48px)/1.1 Arial,sans-serif;letter-spacing:-.035em;color:var(--mesh-ink);margin:0 0 24px}
.mesh-categories,.mesh-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.mesh-category{display:flex;align-items:center;justify-content:space-between;min-height:clamp(128px,17.2vw,210px);padding:12px 7%;border-radius:18px;background:var(--tile);color:var(--mesh-ink);text-decoration:none;overflow:hidden}
.mesh-category>span{font-size:clamp(20px,3.2vw,30px);line-height:1.15;font-weight:700;max-width:48%}
.mesh-category>span>span{padding-left:8px}
.mesh-category img{width:48%;height:clamp(104px,14.4vw,184px);object-fit:contain;mix-blend-mode:multiply}
.mesh-home .mesh-products-heading{margin-top:44px}
.mesh-product{display:block;min-width:0;overflow:hidden;border:1px solid #ece9e5;border-radius:16px;text-decoration:none;background:#fff;color:var(--mesh-ink)}
.mesh-product__image{display:block;width:100%;height:auto;aspect-ratio:1.76;object-fit:contain;background:#f6f3ef;border-radius:16px}
.mesh-product__copy{padding:12px 16px 15px}
.mesh-product h3{margin:0;color:var(--mesh-ink);font:600 clamp(16px,2.4vw,25px)/1.2 Arial,sans-serif;letter-spacing:-.025em}
.mesh-product p{font-size:clamp(18px,2.6vw,28px);line-height:1.2;font-weight:700;margin:7px 0 0}
.mesh-product__availability{display:inline-block;margin-top:8px;font-size:14px;color:#405271}
.mesh-product h3,.mesh-category>span{overflow-wrap:anywhere}
.mesh-home a:focus-visible{outline:3px solid #ff8547;outline-offset:4px}
@media(max-width:749px){.mesh-hero{min-height:620px}.mesh-hero__image{object-position:63% bottom}.mesh-hero__copy{padding:30px 5.5%}.mesh-home h1{font-size:clamp(36px,10.5vw,52px);max-width:440px}.mesh-hero__description{font-size:21px;max-width:360px}.mesh-eyebrow{font-size:13px}.mesh-button{padding:16px 24px;border-radius:16px;font-size:19px}.mesh-content{padding:28px 4%}.mesh-category{min-height:112px;padding:12px 8%}.mesh-category>span{font-size:17px;max-width:56%}.mesh-category img{height:90px;width:44%}.mesh-categories,.mesh-products{gap:12px}.mesh-home h2{font-size:29px}.mesh-product__copy{padding:10px}.mesh-product h3{font-size:15px}.mesh-product p{font-size:18px}.mesh-product__image{aspect-ratio:1.2}}
{% endstylesheet %}
{% schema %}
{
  "name": "Mesh reference homepage",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero",
      "label": "Hero background"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CURIOUS PLAY STARTS HERE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find their next favourite toy"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore RC toys, gadgets, puzzles and hands-on kits."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Shop all toys"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Categories heading",
      "default": "Shop by play style"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "Little finds, big fun"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Text color",
      "default": "#071d49"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Button and eyebrow color",
      "default": "#0754ef"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Page background",
      "default": "#fffcf5"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Uses the collection destination. Title and image below can override the collection content."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Fallback collection link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Background",
          "default": "#e1f0ff"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "paragraph",
          "content": "Select a product to display its current title, price, availability and image. The draft preview fields below appear only in the theme editor until a product is selected and available to the Online Store."
        },
        {
          "type": "image_picker",
          "id": "preview_image",
          "label": "Draft preview image"
        },
        {
          "type": "text",
          "id": "preview_title",
          "label": "Draft preview title"
        },
        {
          "type": "text",
          "id": "preview_price",
          "label": "Draft preview price"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mesh reference homepage",
