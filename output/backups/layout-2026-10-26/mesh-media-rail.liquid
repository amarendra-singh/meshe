{% liquid
  assign visible_count = 0
  assign video_collection = section.settings.video_collection | default: collections['new-arrivals']
  assign automatic_count = 0
  if section.settings.mode == 'video' and section.settings.automatic_videos
    for item in video_collection.products limit: 50
      assign product_video = item.media | where: 'media_type', 'video' | first
      if product_video != blank
        assign automatic_count = automatic_count | plus: 1
        if automatic_count >= section.settings.video_limit
          break
        endif
      endif
    endfor
    assign visible_count = automatic_count
  endif
  for block in section.blocks
    if block.type == section.settings.mode
      if block.settings.demo == false or request.design_mode
        if block.settings.video != blank or block.settings.image != blank
          assign visible_count = visible_count | plus: 1
        endif
      endif
    endif
  endfor
%}
{% if visible_count > 0 or request.design_mode %}
<mesh-media-rail class="mesh-rail mesh-rail--{{ section.settings.mode }}">
  <div class="mesh-rail__heading"><div><p>{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div>{{ section.settings.description | escape }}</div></div>
    <div class="mesh-rail__controls" hidden><button type="button" data-step="-1" aria-label="{{ section.settings.previous_label | escape }}">←</button><button type="button" data-step="1" aria-label="{{ section.settings.next_label | escape }}">→</button></div>
  </div>
  <div class="mesh-rail__track" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
    {% if automatic_count > 0 %}
      {% assign rendered_videos = 0 %}
      {% for item in video_collection.products limit: 50 %}
        {% assign product_video = item.media | where: 'media_type', 'video' | first %}
        {% if product_video != blank %}
          <article class="mesh-rail__card">
            {{ product_video | video_tag: controls: true, autoplay: false, preload: 'none', loading: 'lazy', image_size: '600x', class: 'mesh-rail__media' }}
            <div class="mesh-rail__copy"><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3><p>{{ item.price_min | money }}{% if item.price_varies %} – {{ item.price_max | money }}{% endif %}</p></div>
          </article>
          {% assign rendered_videos = rendered_videos | plus: 1 %}
          {% if rendered_videos >= section.settings.video_limit %}{% break %}{% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% for block in section.blocks %}
      {% if block.type == section.settings.mode %}
        {% if block.settings.demo == false or request.design_mode %}
          {% if block.settings.video != blank or block.settings.image != blank %}
          <article class="mesh-rail__card" {{ block.shopify_attributes }}>
            {% if block.settings.demo %}<p class="mesh-rail__demo">{{ section.settings.demo_label | escape }}</p>{% endif %}
            {% if block.type == 'video' %}
              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag: controls: true, autoplay: false, preload: 'none', loading: 'lazy', image_size: '600x', class: 'mesh-rail__media' }}
              {% else %}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'mesh-rail__media mesh-rail__poster', widths: '280, 450, 700', sizes: '(min-width: 990px) 300px, 75vw' }}
              {% endif %}
            {% else %}
              <a class="mesh-rail__image-link" href="{{ block.settings.image | image_url: width: 1800 }}" target="_blank" rel="noopener" aria-label="{{ section.settings.enlarge_label | escape }}">
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'mesh-rail__media', widths: '300, 600, 900', sizes: '(min-width: 990px) 400px, 80vw', alt: block.settings.title }}
              </a>
            {% endif %}
            <div class="mesh-rail__copy">
              {% assign linked_product = block.settings.product %}
              <h3>{% if linked_product != blank %}<a href="{{ linked_product.url }}">{{ linked_product.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
              {% if block.settings.caption != blank %}<p>{{ block.settings.caption | escape }}</p>{% endif %}
              {% if block.settings.transcript != blank %}<details><summary>{{ section.settings.transcript_label | escape }}</summary><div>{{ block.settings.transcript | escape | newline_to_br }}</div></details>{% endif %}
            </div>
          </article>
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if visible_count == 0 and request.design_mode %}<p class="mesh-rail__empty">Add your videos or permission-cleared customer images in this section. Demo blocks are visible only in the theme editor.</p>{% endif %}
  </div>
</mesh-media-rail>
{% endif %}
{% stylesheet %}
.mesh-rail{display:block;padding:64px max(5%,calc((100% - 1280px)/2));background:#fffcf5;color:#071d49;font-family:Arial,sans-serif}.mesh-rail--review{background:#edf4ff}
.mesh-rail__heading{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:30px}.mesh-rail__heading p{margin:0 0 12px;color:#0754ef;font-weight:700;font-size:13px;letter-spacing:.1em}.mesh-rail h2{font:700 clamp(30px,3.6vw,46px)/1.1 Arial,sans-serif;letter-spacing:-.035em;margin:0 0 16px;color:inherit}.mesh-rail__heading div>div{font-size:18px;color:#405271;line-height:1.5}
.mesh-rail__controls{display:flex;gap:10px}.mesh-rail__controls[hidden]{display:none}.mesh-rail__controls button{width:48px;height:48px;border-radius:50%;border:1px solid #dce3ef;background:white;color:#071d49;cursor:pointer;font-size:22px}.mesh-rail__controls button:disabled{opacity:.35;cursor:default}
.mesh-rail__track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 60px)/4);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 18px;scrollbar-width:thin;overscroll-behavior-x:contain}.mesh-rail--review .mesh-rail__track{grid-auto-columns:calc((100% - 40px)/3)}
.mesh-rail__card{scroll-snap-align:start;overflow:hidden;border-radius:22px;border:1px solid #e5e8ee;background:#fff;align-self:start}.mesh-rail__demo{margin:0;padding:10px 12px;background:#fff0c7;color:#654400;font-size:12px;line-height:1.3;font-weight:700;text-align:center}
.mesh-rail__media{display:block;width:100%;height:auto;aspect-ratio:9/16;object-fit:cover;background:#f3f5f7}.mesh-rail__poster{object-fit:contain;background:white;padding:14px}.mesh-rail--review .mesh-rail__media{aspect-ratio:4/5;object-fit:contain;background:#fff}
.mesh-rail__copy{padding:18px}.mesh-rail h3{font:700 18px/1.35 Arial,sans-serif;color:inherit;margin:0}.mesh-rail h3 a{color:inherit;text-decoration:none}.mesh-rail__copy p,.mesh-rail details{font-size:15px;line-height:1.5;color:#405271}.mesh-rail summary{cursor:pointer;padding:10px 0}.mesh-rail a:focus-visible,.mesh-rail button:focus-visible,.mesh-rail__track:focus-visible{outline:3px solid #ff8547;outline-offset:3px}.mesh-rail__empty{min-width:300px;font-size:16px}
@media(max-width:989px){.mesh-rail{padding:42px 5%}.mesh-rail__track{grid-auto-columns:72%;gap:16px}.mesh-rail--review .mesh-rail__track{grid-auto-columns:82%}.mesh-rail__heading{align-items:start}.mesh-rail__controls{gap:6px}.mesh-rail__controls button{width:44px;height:44px}.mesh-rail h2{font-size:31px}}
{% endstylesheet %}
{% javascript %}
if (!customElements.get('mesh-media-rail')) {
  customElements.define('mesh-media-rail', class extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.mesh-rail__track');
      this.buttons = [...this.querySelectorAll('[data-step]')];
      this.abort = new AbortController();
      const signal = this.abort.signal;
      this.update = () => {
        const maximum = this.track.scrollWidth - this.track.clientWidth;
        this.buttons[0].disabled = this.track.scrollLeft < 2;
        this.buttons[1].disabled = this.track.scrollLeft >= maximum - 2;
        this.querySelector('.mesh-rail__controls').hidden = maximum < 2;
      };
      this.buttons.forEach(button => button.addEventListener('click', () => {
        this.track.scrollBy({left: Number(button.dataset.step) * this.track.clientWidth * .85, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
      }, {signal}));
      this.track.addEventListener('scroll', this.update, {passive:true, signal});
      this.addEventListener('play', event => this.querySelectorAll('video').forEach(video => {if (video !== event.target) video.pause();}), {capture:true, signal});
      document.addEventListener('visibilitychange', () => {if (document.hidden) this.querySelectorAll('video').forEach(video => video.pause());}, {signal});
      this.observer = new ResizeObserver(this.update);
      this.observer.observe(this.track);
      this.update();
    }
    disconnectedCallback() {this.abort?.abort();this.observer?.disconnect();}
  });
}
{% endjavascript %}
