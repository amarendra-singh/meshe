{% for block in section.blocks %}
  {% liquid
    assign shelf = block.settings.collection | default: collections[block.settings.handle]
    assign shelf_title = block.settings.title | default: shelf.title
    assign shelf_count = shelf.products_count | default: 0 | plus: 0
    assign shown_count = shelf_count | at_most: section.settings.limit
    assign shelf_columns = shown_count | at_most: 4 | at_least: 1
  %}
  {% if shelf_count > 0 or request.design_mode %}
  <section class="mesh-shelf{% if shown_count > 0 and shown_count < 3 %} mesh-shelf--compact{% endif %}" style="--shelf-color:{{ block.settings.color }};--shelf-columns:{{ shelf_columns }}" {{ block.shopify_attributes }}>
    <div class="mesh-shelf__inner">
      <header class="mesh-shelf__heading"><div><p>{{ block.settings.eyebrow | escape }}</p><h2>{{ shelf_title | escape }}</h2><div>{{ block.settings.description | escape }}</div></div>
      {% if shelf != blank %}<a href="{{ shelf.url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</header>
      <div class="mesh-shelf__grid">
        {% for item in shelf.products limit: section.settings.limit %}
          {% render 'mesh-product-card', item: item, sold_out_label: section.settings.sold_out_label %}
        {% else %}
          {% if request.design_mode %}
            <div class="mesh-shelf__demo">
              {% if block.settings.preview_image != blank %}{{ block.settings.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '320px', alt: '' }}{% endif %}
              <p>Collection preview · Published products in this collection will appear automatically.</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
{% endfor %}
{% stylesheet %}
.mesh-shelf{background:var(--shelf-color);padding:64px 5%;color:#071d49;font-family:Arial,sans-serif}
.mesh-shelf__inner{max-width:1280px;margin:auto}
.mesh-shelf__heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:30px}
.mesh-shelf__heading p{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin:0 0 12px;color:#0754ef}
.mesh-shelf__heading h2{font:700 clamp(28px,3.4vw,44px)/1.1 Arial,sans-serif;letter-spacing:-.035em;color:inherit;margin:0 0 14px}
.mesh-shelf__heading div>div{font-size:17px;line-height:1.5;max-width:620px;color:#405271}
.mesh-shelf__heading>a{flex-shrink:0;color:inherit;font-size:16px;text-underline-offset:6px;padding:12px 0}
.mesh-shelf__grid{display:grid;grid-template-columns:repeat(var(--shelf-columns,4),minmax(0,1fr));gap:20px}
.mesh-shelf__heading>a:focus-visible{outline:3px solid #ff8547;outline-offset:4px}
@media(min-width:990px){.mesh-shelf--compact .mesh-shelf__inner{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.35fr);align-items:center;gap:clamp(36px,5vw,80px)}.mesh-shelf--compact .mesh-shelf__heading{display:block;margin:0;max-width:440px}.mesh-shelf--compact .mesh-shelf__heading>a{display:inline-flex;align-items:center;gap:16px;margin-top:22px}.mesh-shelf--compact .mesh-shelf__grid{width:100%;max-width:740px;justify-self:center}.mesh-shelf--compact .mesh-product:only-child{width:100%;max-width:380px;justify-self:center}}
.mesh-shelf .mesh-product h3{font-size:18px}.mesh-shelf .mesh-product p{font-size:21px}
.mesh-shelf__demo{grid-column:1/-1;display:flex;align-items:center;gap:32px;background:#ffffffa8;padding:24px;border:1px dashed #a9b7ca;border-radius:20px}.mesh-shelf__demo img{width:180px;max-height:180px;object-fit:contain;mix-blend-mode:multiply}.mesh-shelf__demo p{font-size:17px;max-width:420px}
@media(min-width:750px) and (max-width:989px){.mesh-shelf__grid{grid-template-columns:repeat(min(var(--shelf-columns,4),3),minmax(0,1fr))}.mesh-shelf__grid>.mesh-product:only-child{max-width:400px;justify-self:center;width:100%}}
@media(max-width:749px){.mesh-shelf{padding:40px 5%}.mesh-shelf__heading{display:block}.mesh-shelf__heading>a{display:inline-block;margin-top:8px}.mesh-shelf__grid{grid-template-columns:repeat(min(var(--shelf-columns,4),2),minmax(0,1fr));gap:12px}.mesh-shelf__grid>.mesh-product:only-child{max-width:340px;justify-self:center;width:100%}.mesh-shelf__demo{flex-direction:column;align-items:flex-start}.mesh-shelf .mesh-product h3{font-size:16px}}
{% endstylesheet %}
